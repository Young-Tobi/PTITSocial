extend baseEmail

block content
    .headLogo 
        img(src='cid:ptitsocial-logo' alt='PTITSocial' width='48' height='40')
        span PTITSocial · Xác nhận tài khoản
    p Xin chào #{firstname},
    p Bạn vừa đăng ký tài khoản PTITSocial. Hãy xác nhận địa chỉ email để hoàn tất đăng ký và kết nối với cộng đồng sinh viên PTIT.
    table.btn.btn-primary(role='presentation' border='0' cellpadding='0' cellspacing='0')
        tbody
            tr
                td(align='left')
                    table(role='presentation' border='0' cellpadding='0' cellspacing='0')
                        tbody
                            tr
                                td
                                    a(href=url target='_blank') Xác nhận tài khoản
    p Nếu nút trên không hoạt động, hãy mở đường dẫn sau:
    p
        a(href=url)= url
    p Nếu bạn không đăng ký tài khoản này, bạn có thể bỏ qua email.
    p Đội ngũ PTITSocial
