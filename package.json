{
  "name": "ptitsocial",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start:accounts": "npm run start --workspace @ptitsocial/accounts",
    "start:content": "npm run start --workspace @ptitsocial/content",
    "start:messaging": "npm run start --workspace @ptitsocial/messaging",
    "start:gateway": "npm run start --workspace @ptitsocial/gateway",
    "start:web": "npm --prefix apps/web start",
    "build:web": "npm --prefix apps/web run build",
    "migrate:legacy": "node scripts/migrate-legacy.cjs",
    "check:migration": "node scripts/check-migration.cjs",
    "test:architecture": "node --test tests/architecture.test.cjs",
    "test:integration": "node tests/integration.cjs",
    "format": "prettier --write services packages scripts tests apps/web/src",
    "start:learning": "npm run start --workspace @ptitsocial/learning",
    "test:learning": "node --test tests/learning.test.cjs tests/roadmap-sources.test.cjs tests/gemini-key-pool.test.cjs",
    "test:flashcards": "node --test tests/flashcards.test.cjs",
    "start:study": "npm run start --workspace @ptitsocial/study",
    "seed:study": "npm run seed --workspace @ptitsocial/study",
    "seed:demo-accounts": "node scripts/seed-demo-accounts.cjs",
    "test:study": "node tests/study.integration.cjs",
    "test:study:permissions": "node tests/study-permissions.integration.cjs",
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./start-local.ps1",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./stop-local.ps1",
    "test:documents": "node --test tests/documents/*.test.cjs",
    "test:documents:integration": "node tests/documents/integration.cjs",
    "test:academic": "node --test tests/academic/*.test.cjs",
    "test:academic:integration": "node tests/academic/integration.cjs",
    "test:academic:browser": "node tests/academic/browser.cjs",
    "test:academic:notifications": "node tests/academic/notifications.cjs",
    "test:academic:checklist": "node tests/academic/checklist.cjs",
    "migrate:academic": "node scripts/academic/migrate.cjs",
    "start:coding": "npm run start --workspace @ptitsocial/coding",
    "test:coding": "node --test tests/coding-rules.test.cjs",
    "test:coding:integration": "node tests/coding.integration.cjs",
    "test:coding:languages": "node tests/coding-languages.integration.cjs",
    "start:quiz": "npm run start --workspace @ptitsocial/quiz",
    "test:quiz": "node --test tests/quiz-rules.test.cjs",
    "test:quiz:import": "npm --prefix apps/web test -- --watchAll=false --runInBand --runTestsByPath src/features/quiz/importQuestions.test.js",
    "test:quiz:editor": "npm --prefix apps/web test -- --watchAll=false --runInBand --runTestsByPath src/features/quiz/editorDraft.test.js",
    "test:quiz:integration": "node tests/quiz.integration.cjs",
    "test:quiz:load": "node tests/quiz.load.cjs",
    "test:unit": "node --test tests/*.test.cjs tests/academic/*.test.cjs tests/documents/*.test.cjs",
    "test:web": "npm --prefix apps/web test -- --watchAll=false --runInBand",
    "test:learning:integration": "node tests/learning-integration.cjs",
    "test:social:extended": "node tests/social-base.integration.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.32.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "fcm-node": "^1.6.1",
    "html-to-text": "^8.2.1",
    "jsonwebtoken": "^8.5.1",
    "mongodb": "^4.12.1",
    "mongoose": "^6.7.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.8.0",
    "nodemon": "^2.0.20",
    "pug": "^3.0.2",
    "sharp": "^0.31.2",
    "socket.io": "^4.5.4",
    "unique-username-generator": "^1.1.3",
    "validator": "^13.7.0",
    "xss-clean": "^0.1.1",
    "livekit-server-sdk": "^2.13.1"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "socket.io-client": "^4.5.4",
    "playwright": "^1.65.1"
  }
}
